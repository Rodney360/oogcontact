# Instellingen van de website van Oogcontact bij Gerard
#
# Kopieer dit bestand naar .env.local als je lokaal werkt:
#     cp .env.example .env.local
#
# ZONDER SLEUTELS WERKT DE SITE OOK. Alles draait dan in testmodus:
# het formulier en de boekingsmodule doen alsof, en schrijven wat er verstuurd
# zou zijn naar het terminalvenster. Zo kun je rustig bouwen en testen.
#
# De echte sleutels staan alleen in Vercel (Project Settings > Environment
# Variables), nooit in dit bestand en nooit in de repo. Wil je lokaal met de
# echte sleutels werken, haal ze dan op met de Vercel CLI:
#     npx vercel env pull .env.local


# --- De online agenda (Easy!Appointments) --------------------------------
# Hiermee haalt de site de vrije tijden op en zet hij de afspraak in de agenda.
# Werkt dit niet, kijk dan op de site onder /agenda-controle/: die pagina zegt
# in gewone taal waar het hangt. De stappen staan in docs/agenda-koppelen.md.
#
# Let op: in het beheerscherm van OO2 is geen knop om een sleutel aan te maken.
# Bij Easy!Appointments staat die in een bestand op de server. Gebruik dan de
# gebruikersnaam en het wachtwoord hieronder, of vraag OO2 om een sleutel.
EASYAPPOINTMENTS_URL=https://oogcontactbijgerard.oo2.online
EASYAPPOINTMENTS_API_KEY=
# Sommige versies van Easy!Appointments werken met een gebruikersnaam en
# wachtwoord in plaats van een sleutel. Vul dan deze twee in en laat de
# sleutel hierboven leeg.
EASYAPPOINTMENTS_GEBRUIKER=
EASYAPPOINTMENTS_WACHTWOORD=


# --- E-mail versturen (Resend) -------------------------------------------
# Hiermee gaat het ingevulde formulier naar de winkel en krijgt de klant een
# bevestiging. De sleutel maak je aan op resend.com onder API Keys.
RESEND_API_KEY=
# Het adres waarvandaan de mail verstuurd wordt. Dit moet een adres zijn op een
# domein dat in Resend geverifieerd is (SPF en DKIM), anders belandt de mail
# in de spam.
MAIL_AFZENDER="Oogcontact bij Gerard <website@oogcontactbijgerard.nl>"
# Waar de aanvragen naartoe gaan.
MAIL_ONTVANGER=info@oogcontactbijgerard.nl


# --- Spambeveiliging (Cloudflare Turnstile) ------------------------------
# Onzichtbare controle die bots tegenhoudt zonder dat de bezoeker iets merkt.
# Aanmaken op dash.cloudflare.com onder Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# --- De site zelf ---------------------------------------------------------
# Het adres waarop de site draait. Vercel vult dit zelf goed in; lokaal hoeft
# het niet. Zet het op de productie-URL zodra het domein live staat.
NEXT_PUBLIC_SITE_URL=https://oogcontactbijgerard.nl


# --- Het beheerscherm op /keystatic --------------------------------------
# Zonder deze regels schrijft het beheerscherm in de bestanden op de computer
# waar de site draait. Lokaal (`npm run dev`) is dat precies goed. Op Vercel
# niet: die computer bestaat maar heel even en is alleen-lezen, dus opslaan
# doet daar niets - zonder foutmelding. De site laat het scherm dan bewust niet
# zien; zie src/lib/beheer.ts.
#
# Staat deze wel ingevuld, dan wordt opslaan een commit in de repo en staat het
# een paar minuten later live. Dat is wat Gerard en Gerda nodig hebben.
KEYSTATIC_GITHUB_REPO=Rodney360/oogcontact
# Deze vier komen uit de GitHub-app die je eenmalig aanmaakt. De stappen staan
# in docs/live-gaan.md. De slug is de naam van die app zoals hij in het adres
# staat; die mag gewoon zichtbaar zijn, de andere drie niet.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
