{
  "name": "oogcontactbijgerard",
  "version": "1.0.0",
  "private": true,
  "description": "Website van Oogcontact bij Gerard - opticien in Groningen",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:ui": "playwright test --ui",
    "images": "node scripts/process-images.mjs",
    "crawl": "node scripts/crawl-wordpress.mjs",
    "test:unit": "node --experimental-strip-types --test tests/unit/**/*.test.ts",
    "test:e2e": "playwright test",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:contrast && npm run test:unit"
  },
  "dependencies": {
    "@keystatic/core": "^0.6.9",
    "@keystatic/next": "^5.0.5",
    "@markdoc/markdoc": "^0.5.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.3.0",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "resend": "^6.28.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "potrace": "^2.1.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
